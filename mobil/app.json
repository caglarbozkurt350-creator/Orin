{
  "expo": {
    "name": "Orvane",
    "slug": "orvane",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orvane",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#18181a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.caglar.orvane"
    },
    "android": {
      "package": "com.caglar.orvane",
      "adaptiveIcon": {
        "backgroundColor": "#18181a",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6d799722-ce59-4713-a7b2-1b1e663ab274"
      }
    },
    "owner": "caglarbozkurt350-2"
  }
}
