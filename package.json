{
  "name": "orin",
  "productName": "Orin",
  "version": "0.4.0",
  "description": "Orin · iş raporu masaüstü uygulaması",
  "main": "main.js",
  "author": "Çağlar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win nsis",
    "seed": "electron . --seed"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.caglar.orin",
    "productName": "Orin",
    "files": [
      "main.js",
      "preload.js",
      "sheets.js",
      "renderer/**",
      "assets/**",
      "!renderer/js/kisisel.js",
      "export.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Orin",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055"
    },
    "publish": {
      "provider": "github",
      "owner": "caglarbozkurt350-creator",
      "repo": "Orin",
      "releaseType": "release"
    },
    "artifactName": "Orin-Kurulum-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "@tabler/icons-webfont": "3.19.0"
  },
  "repository": "https://github.com/caglarbozkurt350-creator/Orin"
}
